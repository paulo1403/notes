---
import Base from "../layouts/Base.astro";
---
<Base title="Notes">
  <main class="landing">
    <p class="share-read kicker">Open source</p>
    <h1>Notes on paper. Share with a link.</h1>
    <p>Markdown writing for daytime work. Auth for you and a few people. Attachments on MinIO.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/login">Sign in</a>
      <a class="btn btn-secondary" href="/app">Open app</a>
    </div>
  </main>
</Base>
