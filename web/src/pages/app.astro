---
import Base from "../layouts/Base.astro";
---
<Base title="Notes">
  <div class="app-layout">
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-head">
        <h1>Notes</h1>
        <button id="theme-btn" style="font-size:0.9rem;" title="Toggle theme">◐</button>
        <button id="new" title="New note">+</button>
      </div>
      <div class="sidebar-search">
        <input id="q" type="search" placeholder="Search" aria-label="Search" />
      </div>
      <nav class="sidebar-nav" id="list" role="listbox" aria-label="Notes">
        <div class="empty-state" style="justify-content:start;padding:1rem 0.75rem;" hidden id="empty">
          <p style="margin:0;font-size:0.8125rem;">No notes yet.</p>
        </div>
      </nav>
    </aside>
    <main class="main-area">
      <div class="empty-state" id="main-empty">
        <h2>Select a note</h2>
        <p>Pick one from the sidebar or create a new one.</p>
      </div>
    </main>
  </div>
  <div id="folder-prompt" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:100;align-items:center;justify-content:center;">
    <div class="sidebar" style="position:static;width:320px;border-radius:var(--radius);">
      <div class="sidebar-head"><h1>Choose folder</h1></div>
      <div class="sidebar-nav" id="folder-list" style="padding:0.5rem;"></div>
    </div>
  </div>
  <script>
    const list = document.getElementById("list");
    const empty = document.getElementById("empty");
    const mainEmpty = document.getElementById("main-empty");
    const q = document.getElementById("q");
    const themeBtn = document.getElementById("theme-btn");

    themeBtn.addEventListener("click", () => {
      const isLight = document.documentElement.className === "light";
      document.documentElement.className = isLight ? "" : "light";
      localStorage.setItem("notes-theme", isLight ? "dark" : "light");
    });

    function escapeHtml(s) {
      return (s || "").replace(/[&<>"]/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;" })[c]);
    }

    async function requireAuth() {
      const res = await fetch("/api/auth/me", { credentials: "include" });
      if (!res.ok) location.href = "/login";
    }

    let notes = [];
    let folders = [];

    async function loadFolders() {
      const res = await fetch("/api/folders", { credentials: "include" });
      if (res.ok) folders = (await res.json()).folders || [];
    }

    async function loadNotes() {
      const url = q.value.trim() ? `/api/notes?q=${encodeURIComponent(q.value.trim())}` : "/api/notes";
      const res = await fetch(url, { credentials: "include" });
      if (!res.ok) return location.href = "/login";
      const data = await res.json();
      notes = data.notes;
      renderSidebar();
    }

    function renderSidebar() {
      list.innerHTML = "";
      if (!notes.length) { empty.hidden = false; return; }
      empty.hidden = true;

      const grouped = new Map();
      for (const n of notes) {
        const f = n.folder || "(no folder)";
        if (!grouped.has(f)) grouped.set(f, []);
        grouped.get(f).push(n);
      }

      let i = 0;
      for (const [folder, items] of grouped) {
        const header = document.createElement("div");
        header.style.cssText = "padding:0.5rem 0.85rem 0.25rem;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);font-weight:600;";
        header.textContent = folder;
        list.appendChild(header);
        for (const n of items) {
          const a = document.createElement("a");
          a.className = "nav-item" + (i === 0 ? " active" : "");
          a.href = `/note/${n.id}`;
          const vis = String(n.visibility).toLowerCase();
          a.innerHTML = `<span class="grow">${escapeHtml(n.title)}</span>${n.visibility !== "PRIVATE" ? `<span class="badge ${vis}">${escapeHtml(n.visibility)}</span>` : ""}`;
          a.addEventListener("click", (e) => {
            e.preventDefault();
            location.href = `/note/${n.id}`;
          });
          list.appendChild(a);
          i++;
        }
      }
    }

    async function createNote(folder) {
      const t = prompt("Title", "Untitled");
      if (!t?.trim()) return;
      const res = await fetch("/api/notes", {
        method: "POST",
        credentials: "include",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ title: t.trim(), body: "", folder: folder || null }),
      });
      if (!res.ok) return alert("Create failed");
      const data = await res.json();
      location.href = `/note/${data.note.id}`;
    }

    document.getElementById("new").addEventListener("click", async () => {
      await loadFolders();
      const promptDiv = document.getElementById("folder-prompt");
      const folderList = document.getElementById("folder-list");
      folderList.innerHTML = `<div class="nav-item" id="folder-none" style="cursor:pointer;"><span class="grow">No folder</span></div>`;
      for (const f of folders) {
        const div = document.createElement("div");
        div.className = "nav-item";
        div.style.cursor = "pointer";
        div.innerHTML = `<span class="grow">${escapeHtml(f.name)}</span><span style="color:var(--muted);font-size:0.75rem;">${f.count}</span>`;
        div.addEventListener("click", () => { promptDiv.style.display = "none"; createNote(f.name); });
        folderList.appendChild(div);
      }
      document.getElementById("folder-none").addEventListener("click", () => { promptDiv.style.display = "none"; createNote(""); });
      promptDiv.style.display = "flex";
      promptDiv.addEventListener("click", (e) => { if (e.target === promptDiv) promptDiv.style.display = "none"; });
    });

    let timer;
    q.addEventListener("input", () => { clearTimeout(timer); timer = setTimeout(loadNotes, 150); });

    await requireAuth();
    await loadFolders();
    await loadNotes();
  </script>
</Base>
