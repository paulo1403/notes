---
import Base from "../layouts/Base.astro";
---
<Base title="Notes">
  <div class="app-layout">
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-head">
        <h1>Notes</h1>
        <button id="theme-btn" title="Toggle theme" style="font-size:0.9rem;">◐</button>
        <button id="new">+</button>
      </div>
      <div class="sidebar-search">
        <input id="q" type="search" placeholder="Search" aria-label="Search" />
      </div>
      <nav class="sidebar-nav" id="list" role="listbox" aria-label="Notes">
        <div class="empty-state" style="justify-content:start;padding:1rem 0.75rem;" hidden id="empty">
          <p style="margin:0;font-size:0.8125rem;">No notes yet.</p>
        </div>
      </nav>
    </aside>
    <main class="main-area">
      <div class="empty-state" id="main-empty">
        <h2>Select a note</h2>
        <p>Pick one from the sidebar or create a new one.</p>
      </div>
    </main>
  </div>
  <script>
    const list = document.getElementById("list");
    const empty = document.getElementById("empty");
    const mainEmpty = document.getElementById("main-empty");
    const q = document.getElementById("q");
    const themeBtn = document.getElementById("theme-btn");

    function theme() {
      const isLight = document.documentElement.className === "light";
      document.documentElement.className = isLight ? "" : "light";
      localStorage.setItem("notes-theme", isLight ? "dark" : "light");
    }
    themeBtn.addEventListener("click", theme);

    function escapeHtml(s) {
      return s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
    }

    async function requireAuth() {
      const res = await fetch("/api/auth/me", { credentials: "include" });
      if (!res.ok) location.href = "/login";
      return (await res.json()).user;
    }

    let notes = [];

    async function loadNotes() {
      const url = q.value.trim() ? `/api/notes?q=${encodeURIComponent(q.value.trim())}` : "/api/notes";
      const res = await fetch(url, { credentials: "include" });
      if (!res.ok) return location.href = "/login";
      const data = await res.json();
      notes = data.notes;
      list.innerHTML = "";
      if (!notes.length) {
        empty.hidden = false;
        return;
      }
      empty.hidden = true;
      for (const n of notes) {
        const a = document.createElement("a");
        a.className = "nav-item";
        a.href = `/note/${n.id}`;
        a.setAttribute("role", "option");
        const vis = String(n.visibility).toLowerCase();
        a.innerHTML = `<span class="grow">${escapeHtml(n.title)}</span>${n.visibility !== "PRIVATE" ? `<span class="badge ${vis}">${escapeHtml(n.visibility)}</span>` : ""}`;
        a.addEventListener("click", (e) => {
          e.preventDefault();
          loadNote(n.id);
        });
        list.appendChild(a);
      }
    }

    function loadNote(id) {
      location.href = `/note/${id}`;
    }

    document.getElementById("new").addEventListener("click", async () => {
      const t = prompt("Title", "Untitled");
      if (!t?.trim()) return;
      const res = await fetch("/api/notes", {
        method: "POST",
        credentials: "include",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ title: t.trim(), body: "" }),
      });
      if (!res.ok) return alert("Create failed");
      const data = await res.json();
      location.href = `/note/${data.note.id}`;
    });

    let timer;
    q.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(loadNotes, 150);
    });

    await requireAuth();
    await loadNotes();
  </script>
</Base>
