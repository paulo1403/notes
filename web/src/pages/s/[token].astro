---
import Base from "../../layouts/Base.astro";
export async function getStaticPaths() {
  return [{ params: { token: "_dummy" } }];
}
const { token } = Astro.params;
---
<Base title="Shared note · Notes">
  <main class="share-wrap">
    <p class="label">Shared note</p>
    <h1 id="title">…</h1>
    <article id="body" class="share-body">Loading…</article>
  </main>
  <script define:vars={{ token }}>
    const t = document.getElementById("title");
    const b = document.getElementById("body");
    try {
      const res = await fetch(`/api/s/${token}`);
      if (!res.ok) {
        t.textContent = "Not found";
        b.innerHTML = "<p style='color:var(--muted);'>This link is invalid or revoked.</p>";
      } else {
        const d = await res.json();
        t.textContent = d.note.title;
        b.innerHTML = d.note.html;
        document.title = `${d.note.title} · Notes`;
      }
    } catch { t.textContent = "Error"; }
  </script>
</Base>
