---
import Base from "../../layouts/Base.astro";
export async function getStaticPaths() {
  return [{ params: { id: "_dummy" } }];
}
---
<Base title="Edit · Notes">
  <div class="app-layout">
    <main class="main-area">
      <div class="editor-top">
        <button id="back" class="ghost"><span class="lucide" data-icon="menu"></span></button>
        <span class="status" id="status-bar">Loading…</span>
        <button id="folder-btn" class="ghost" style="font-size:0.8125rem;color:var(--muted);"><span class="lucide" data-icon="folder"></span> <span id="folder-label">none</span></button>
        <button id="share"><span class="lucide" data-icon="share"></span></button>
        <button id="export"><span class="lucide" data-icon="download"></span></button>
        <button class="primary" id="save">Save</button>
        <button class="danger" id="del"><span class="lucide" data-icon="trash-2"></span></button>
      </div>
      <div class="editor-scroll">
        <input id="title" class="title-field" placeholder="Note title" aria-label="Title" />
        <div class="editor-split">
          <div class="editor-pane">
            <textarea id="body" placeholder="Write in Markdown…" aria-label="Body"></textarea>
          </div>
          <div class="preview-pane" id="preview" aria-live="polite"></div>
        </div>
        <section class="attach-area" aria-label="Attachments">
          <div class="attach-head">
            <strong>Attachments</strong>
            <input class="file-input" id="file" type="file" aria-label="Choose" />
            <button id="upload">Upload</button>
          </div>
          <div id="files"></div>
        </section>
      </div>
    </main>
  </div>
  <script>
    const noteId = location.pathname.split("/").pop();
    if (!noteId || noteId === "_dummy") throw new Error("no id");

    document.getElementById("back")?.addEventListener("click", () => location.href = "/app");

    const titleEl = document.getElementById("title");
    const bodyEl = document.getElementById("body");
    const preview = document.getElementById("preview");
    const status = document.getElementById("status-bar");
    const files = document.getElementById("files");
    let note = null, dirty = false;

    function escapeHtml(s) { return (s||"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"})[c]); }

    function mdToHtml(t) {
      return escapeHtml(t)
        .replace(/^### (.+)$/gm,"<h3>$1</h3>").replace(/^## (.+)$/gm,"<h2>$1</h2>").replace(/^# (.+)$/gm,"<h1>$1</h1>")
        .replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>").replace(/\*(.+?)\*/g,"<em>$1</em>").replace(/`([^`]+)`/g,"<code>$1</code>")
        .replace(/^- (.+)$/gm,"<li>$1</li>").replace(/\n\n/g,"</p><p>").replace(/^([^<].*)$/gm,m=>m.startsWith("<")?m:`<p>${m}</p>`);
    }

    function render() {
      preview.innerHTML = bodyEl.value.trim() ? mdToHtml(bodyEl.value) : '<span style="color:var(--muted);">Preview</span>';
    }

    function setStatus(t, k) { status.textContent = t; status.className = "status" + (k ? ` ${k}` : ""); }

    async function load() {
      const me = await fetch("/api/auth/me", { credentials: "include" });
      if (!me.ok) return location.href = "/login";
      const r = await fetch(`/api/notes/${noteId}`, { credentials: "include" });
      if (!r.ok) { setStatus("Not found","err"); return; }
      const d = await r.json();
      note = d.note;
      titleEl.value = note.title;
      bodyEl.value = note.body;
      document.getElementById("folder-label").textContent = note.folder || "none";
      dirty = false;
      setStatus(note.visibility + (note.shareToken ? ` · s/${note.shareToken}` : ""));
      render();
      files.innerHTML = "";
      for (const a of note.attachments || []) {
        const row = document.createElement("div"); row.className = "attach-row";
        row.innerHTML = `<span class="grow">${escapeHtml(a.filename)}</span><button data-id="${a.id}">Open</button>`;
        row.querySelector("button").onclick = async () => {
          const u = await fetch(`/api/attachments/${a.id}/url`, { credentials: "include" });
          const j = await u.json();
          if (j.url) window.open(j.url, "_blank", "noopener");
        };
        files.appendChild(row);
      }
      if (!(note.attachments||[]).length) files.innerHTML = '<span style="color:var(--muted);font-size:0.8125rem;">No attachments.</span>';
    }

    async function save() {
      setStatus("Saving…");
      const r = await fetch(`/api/notes/${noteId}`, {
        method: "PATCH", credentials: "include",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ title: titleEl.value, body: bodyEl.value }),
      });
      if (!r.ok) { setStatus("Save failed","err"); return; }
      dirty = false; setStatus("Saved","ok");
    }

    document.getElementById("save").onclick = save;
    document.getElementById("del").onclick = async () => {
      if (!confirm("Delete permanently?")) return;
      await fetch(`/api/notes/${noteId}`, { method: "DELETE", credentials: "include" });
      location.href = "/app";
    };
    document.getElementById("export").onclick = () => window.open(`/api/notes/${noteId}/export`, "_blank");
    document.getElementById("folder-btn").onclick = async () => {
      const f = prompt("Folder name", note?.folder || "");
      if (f === null) return;
      const v = f.trim() || null;
      await fetch(`/api/notes/${noteId}`, {
        method: "PATCH", credentials: "include",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ folder: v }),
      });
      document.getElementById("folder-label").textContent = v || "none";
    };
    document.getElementById("share").onclick = async () => {
      const mode = prompt("Visibility: PRIVATE / LINK / PUBLIC", note?.visibility || "LINK");
      if (!mode) return;
      const expiresIn = mode === "LINK" ? parseInt(prompt("Expire in seconds (blank=never)","")||"0") : 0;
      const body = { visibility: mode.toUpperCase() };
      if (expiresIn > 0) body.expiresIn = expiresIn;
      const r = await fetch(`/api/notes/${noteId}/share`, {
        method: "POST", credentials: "include",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(body),
      });
      if (!r.ok) { setStatus("Share failed","err"); return; }
      const d = await r.json();
      note = d.note;
      setStatus(note.visibility + (note.shareToken ? ` · s/${note.shareToken}` : ""), "ok");
      if (note.shareToken) {
        const url = `${location.origin}/s/${note.shareToken}`;
        await navigator.clipboard.writeText(url).catch(()=>{});
        alert(`Link copied:\n${url}`);
      }
    };
    document.getElementById("upload").onclick = async () => {
      const input = document.getElementById("file");
      if (!input.files?.length) return alert("Pick a file");
      const fd = new FormData(); fd.append("file", input.files[0]);
      setStatus("Uploading…");
      const r = await fetch(`/api/notes/${noteId}/attachments`, { method: "POST", credentials: "include", body: fd });
      setStatus(r.ok ? "Uploaded" : "Upload failed", r.ok ? "ok" : "err");
      if (r.ok) load();
    };

    titleEl.addEventListener("input", () => { if (!dirty) { dirty = true; setStatus("Unsaved"); } });
    bodyEl.addEventListener("input", () => { if (!dirty) { dirty = true; setStatus("Unsaved"); } render(); });
    window.addEventListener("keydown", (e) => { if ((e.metaKey||e.ctrlKey) && e.key === "s") { e.preventDefault(); save(); } });
    load();
  </script>
</Base>
